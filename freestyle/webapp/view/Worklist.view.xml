<mvc:View
    controllerName="demo.orders.freestyle.controller.Worklist"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.layout"
    xmlns="sap.m">
    <f:DynamicPage id="worklistPage" headerExpanded="true" toggleHeaderOnTitleClick="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>worklistTitle}"/>
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <!-- Filterleiste: in Fiori Elements = 1 Annotation (UI.SelectionFields) -->
        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <fb:Grid defaultSpan="XL3 L3 M6 S12" vSpacing="0">
                    <VBox>
                        <Label text="{i18n>filterCustomer}:" labelFor="customerFilter"/>
                        <MultiInput
                            id="customerFilter"
                            showValueHelp="true"
                            valueHelpRequest=".onCustomerValueHelp"
                            submit=".onSearch"/>
                    </VBox>
                    <VBox>
                        <Label text="{i18n>filterCountry}:" labelFor="countryFilter"/>
                        <Input id="countryFilter" submit=".onSearch"/>
                    </VBox>
                    <VBox>
                        <Label text="{i18n>filterOrderDate}:" labelFor="orderDateFilter"/>
                        <DateRangeSelection id="orderDateFilter"/>
                    </VBox>
                    <HBox alignItems="End" height="100%" justifyContent="End">
                        <Button text="{i18n>filterGo}" type="Emphasized" press=".onSearch" class="sapUiTinyMarginEnd"/>
                        <Button text="{i18n>filterReset}" type="Transparent" press=".onResetFilters"/>
                    </HBox>
                </fb:Grid>
            </f:DynamicPageHeader>
        </f:header>

        <!-- Tabelle: in Fiori Elements = 1 Annotation (UI.LineItem) -->
        <f:content>
            <Table
                id="ordersTable"
                width="auto"
                growing="true"
                growingThreshold="20"
                growingScrollToLoad="true"
                noDataText="{i18n>tableNoDataText}"
                updateFinished=".onUpdateFinished"
                items="{
                    path: '/Orders',
                    parameters: {
                        $count: true,
                        $expand: 'Customer($select=CompanyName)'
                    },
                    sorter: { path: 'OrderID' }
                }">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title id="tableHeader" text="{i18n>worklistTableTitleNoCount}" level="H2"/>
                        <ToolbarSpacer/>
                        <Button icon="sap-icon://sort" tooltip="{i18n>sortButton}" press=".onOpenSortDialog"/>
                        <Button icon="sap-icon://excel-attachment" tooltip="{i18n>exportButton}" press=".onExport"/>
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column><Text text="{i18n>colOrderID}"/></Column>
                    <Column width="16rem"><Text text="{i18n>colCustomer}"/></Column>
                    <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colOrderDate}"/></Column>
                    <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colShippedDate}"/></Column>
                    <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colShipCity}"/></Column>
                    <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colShipCountry}"/></Column>
                    <Column hAlign="End"><Text text="{i18n>colFreight}"/></Column>
                </columns>
                <items>
                    <ColumnListItem type="Navigation" press=".onPress">
                        <cells>
                            <Text text="{OrderID}"/>
                            <Text text="{
                                parts: ['Customer/CompanyName', 'CustomerID'],
                                formatter: '.formatter.textWithId'
                            }"/>
                            <Text text="{OrderDate}"/>
                            <Text text="{ShippedDate}"/>
                            <Text text="{ShipCity}"/>
                            <Text text="{ShipCountry}"/>
                            <Text text="{Freight}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </f:content>
    </f:DynamicPage>
</mvc:View>
